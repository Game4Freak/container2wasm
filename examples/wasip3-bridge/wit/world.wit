// Interfaces bridged into the container by this example.
package example:greeter@0.1.0;

/// Implemented by the host; called from inside the container.
interface host {
    greet: async func(name: string) -> string;
    add: func(a: u32, b: u32) -> u32;
}

/// Implemented inside the container; called by the host.
interface guest {
    handle: async func(msg: string) -> string;
}

world app {
    import host;
    export guest;
}
